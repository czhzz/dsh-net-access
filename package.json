{
  "name": "dsh-net-access",
  "version": "0.1.1",
  "description": "Control how the DeepSeek Harness Web GUI is reachable: local only, Tailscale, all local networks, or off.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/czhzz/dsh-net-access.git"
  },
  "homepage": "https://github.com/czhzz/dsh-net-access#readme",
  "bugs": {
    "url": "https://github.com/czhzz/dsh-net-access/issues"
  },
  "keywords": [
    "deepseek-harness",
    "dsh-plugin",
    "dsh",
    "remote-access",
    "tailscale",
    "lan",
    "cordis"
  ],
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "main": "./lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node tests/detect.test.js && node tests/peer-range.check.mjs",
    "check:lib": "npm run build && git diff --exit-code -- lib/"
  },
  "peerDependencies": {
    "@deepseek-ai/schemastery": ">=3.18.2 <4"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/schemastery": {
      "optional": true
    }
  },
  "devDependencies": {
    "@deepseek-ai/schemastery": "^3.18.2",
    "esbuild": "^0.25.0",
    "lightningcss": "^1.28.0",
    "semver": "^7.7.0"
  }
}
