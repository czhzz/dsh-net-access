# Dependencies come from `npm install` (see package.json devDependencies); the
# build and tests resolve them from this directory first and only fall back to a
# sibling harness checkout.
node_modules/
.npm-cache/

# Build-time residue. `lib/` is intentionally NOT ignored: the shipped client
# bundle is committed so `dsh plugin add github:…` needs no local build and no
# pnpm build approval.
*.log
.DS_Store
Thumbs.db

# Local scratch: marketplace-submission drafts and any other machine-local
# working files. Nothing here is part of the published plugin, so it must never
# reach the public repository.
.local/
